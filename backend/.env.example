# Copy this file to .env for local development.
# In production, these are set through TechNE's Python App config — never
# committed and never stored in a local .env that could get committed by accident.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=mysql
DB_NAME=glitz_dev
DB_USER=glitz
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Comma-separated list of origins allowed to call this API — the Next.js
# frontend's own origin(s), never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

WAGTAILADMIN_BASE_URL=http://localhost:8000

# Stripe — test keys locally, live keys only ever set via TechNE in prod.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Visitor accounts. Register this exact Google OAuth redirect URI:
# <FRONTEND_BASE_URL>/api/visitor/google/callback
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verification and password-reset email only (not newsletter campaigns).
# Keep disabled until SMTP is configured; for local testing, explicitly enable
# it with dev.py's console email backend and use links printed in the terminal.
AUTH_EMAIL_ENABLED=False
DEFAULT_FROM_EMAIL=Glitz Africa <accounts@example.com>
WAGTAILADMIN_NOTIFICATION_FROM_EMAIL=Glitz Africa <notifications@example.com>
EMAIL_HOST=mail.supremecluster.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
# For real delivery, including from development:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
