# Copy this file to .env for local development.
# In production, these are set through TechNE's Python App config — never
# committed and never stored in a local .env that could get committed by accident.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=glitz_dev
DB_USER=glitz
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of origins allowed to call this API — the Next.js
# frontend's own origin(s), never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

WAGTAILADMIN_BASE_URL=http://localhost:8000

# Paystack — test keys locally, live keys only ever set via TechNE in prod.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
